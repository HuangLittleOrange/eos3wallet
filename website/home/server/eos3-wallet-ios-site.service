[Unit]
Description=Refresh EOS3 Wallet website iOS version from published update catalog
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=eos3-wallet-mirror
Group=eos3-wallet-mirror
ExecStart=/usr/bin/python3 -B /usr/local/lib/eos3-wallet-mirror/sync_ios_release.py
TimeoutStartSec=60s
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/eos3-wallet-mirror
