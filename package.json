{
  "name": "eostp",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "26.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/elements": "^2.9.39",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@scure/bip32": "^2.3.0",
    "@scure/bip39": "^2.3.0",
    "@wharfkit/antelope": "^1.2.0",
    "@wharfkit/session": "^1.6.1",
    "@wharfkit/signing-request": "^3.4.0",
    "@wharfkit/wallet-plugin-privatekey": "^1.1.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.14",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "pako": "^3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-passkeys": "^0.4.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode@3.0.1": {
      "uuid": "11.1.1"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  },
  "scripts": {
    "patch:dependencies": "node scripts/dependency-policy.cjs && node scripts/dependency-patches.cjs --apply",
    "check:dependencies": "node scripts/dependency-policy.cjs && node scripts/dependency-patches.cjs --check",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node scripts/run-tests.cjs",
    "test:update-native": "node --test scripts/__tests__/update-package-policy.test.mjs",
    "test:dependencies": "node --test scripts/__tests__/dependency-patches.test.mjs scripts/__tests__/dependency-policy.test.mjs scripts/__tests__/native-sandbox.test.mjs",
    "typecheck": "tsc --noEmit",
    "licenses": "node scripts/generate-notices.mjs",
    "check:source": "node scripts/check-source.mjs",
    "install:safe": "node scripts/dependency-policy.cjs && npm ci --ignore-scripts && npm run verify:provenance && npm run patch:dependencies",
    "verify:provenance": "node scripts/dependency-policy.cjs && npm audit signatures",
    "verify:isolated": "node scripts/isolated-build.cjs",
    "eas-build-pre-install": "node scripts/dependency-policy.cjs",
    "eas-build-post-install": "npm run verify:provenance && npm run patch:dependencies",
    "build:android:isolated": "node scripts/build-android-isolated.cjs",
    "prepare:android:cache": "node scripts/build-android-isolated.cjs --prepare-cache",
    "sign:android:test": "node scripts/sign-android-test.cjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/",
      "<rootDir>/.codex/",
      "<rootDir>/exports/",
      "<rootDir>/backups/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/",
      "<rootDir>/.codex/",
      "<rootDir>/exports/",
      "<rootDir>/backups/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jest-)?react-native|@react-native|expo(nent)?|@expo(nent)?|@expo-google-fonts|react-navigation|@react-navigation|@sentry|native-base|react-native-.*|@noble|@scure|@wharfkit|pako)"
    ]
  }
}
